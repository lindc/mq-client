<?xml version="1.0" encoding="UTF-8"?>
<!--
  应用自带的 RocketMQ 客户端日志配置 —— **所有 RocketMQ 日志的唯一落点声明**。

  为什么这份文件在 rocketmq-service 而不是 app-ui：
  - RocketMQ 5.x 的 shaded logback（io.github.aliyunmq:rocketmq-logback-classic）
    只初始化一个 LoggerContext，配置由 DefaultJoranConfiguratorExt 按名称顺序查找：
      rmq.logback-test.xml → **rmq.logback.xml** → rmq.proxy → rmq.broker →
      rmq.namesrv → rmq.controller → rmq.tools.logback.xml → rmq.client.logback.xml
  - jar 内 rmq.tools.logback.xml 把 <file> 写死成
    ${user.home}/logs/rocketmqlogs/tools.log，**不读任何 logRoot 属性**；
    rmq.client.logback.xml 的默认值同样是 ${user.home}/logs/rocketmqlogs。
  - 因此「只设系统属性」永远治不了 tools 那份；唯一可靠的手段是让
    rmq.logback.xml 出现在 classpath 上（按名称排在 tools/client 之前）。
  - 放在 rocketmq-service 的 resources 里 = 只要火箭 MQ 在 classpath，这份配置就在：
    应用、各模块测试、诊断工具、未来的 CLI 都覆盖，不再依赖某个入口先跑 setProperty。

  LOG_HOME 三级回退，任何一级都不指向 ${user.home}/logs：
    rocketmq.log.root（RocketMqLogging.install 设置）
      → ${mqclient.config.dir}/logs/rocketmqlogs（便携模式 / 测试重定向）
      → ${user.home}/.mqclient/logs/rocketmqlogs
-->
<configuration>
    <property name="LOG_HOME"
              value="${rocketmq.log.root:-${mqclient.config.dir:-${user.home}${file.separator}.mqclient}${file.separator}logs${file.separator}rocketmqlogs}"/>

    <conversionRule conversionWord="pid"
                    converterClass="io.github.aliyunmq.logback.extensions.ProcessIdConverter"/>

    <appender name="CustomConsoleAppender" class="io.github.aliyunmq.logback.extensions.CustomConsoleAppender">
        <encoder>
            <pattern>%yellow(%d{yyy-MM-dd HH:mm:ss.SSS,GMT+8}) %highlight(%-5p) %boldWhite([%pid]) %magenta([%t]) %boldGreen([%logger{12}#%M:%L]) - %m%n</pattern>
            <charset class="java.nio.charset.Charset">UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DefaultAppenderInner" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <append>true</append>
        <File>${LOG_HOME}${file.separator}rocketmq_client.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <FileNamePattern>${LOG_HOME}${file.separator}other_days${file.separator}rocketmq_client-%i.log.gz</FileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>${rocketmq.log.file.maxIndex:-10}</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>64MB</maxFileSize>
        </triggeringPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyy-MM-dd HH:mm:ss.SSS,GMT+8} %-5p [%pid] [%t] [%logger{12}#%M:%L] - %m%n</pattern>
            <charset class="java.nio.charset.Charset">UTF-8</charset>
        </encoder>
    </appender>
    <appender name="DefaultAppender" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DefaultAppenderInner"/>
    </appender>

    <root level="${rocketmq.log.level:-info}">
        <appender-ref ref="CustomConsoleAppender"/>
        <appender-ref ref="DefaultAppender" additivity="false"/>
    </root>
</configuration>
