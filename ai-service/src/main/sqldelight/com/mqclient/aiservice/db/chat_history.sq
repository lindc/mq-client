-- 对话审计表：只在 AI 回复完成后插入一条完整记录。
-- 只插入，不更新，不删除（cleanOld 是按保留天数的清理，不算业务删除）。
-- FAILED 记录只进审计，面板加载对话历史时按 status 过滤。
-- 生成物说明：物理表名与列名均蛇形，SQLDelight 生成的数据类是 `Chat_history`、
-- 属性名与列名一致（snake_case，无驼峰转换）。
-- 链路分析（MQ 对象「询问 AI」）的记录 object_type 非空，且 context_json 存上下文 JSON
-- （currentTime/chain/userQuestion，**未包不可信边界**）；普通聊天这三列为 NULL。
-- 包裹（[BEGIN UNTRUSTED CONTEXT] … [END UNTRUSTED CONTEXT]）只在发给模型的那份上
-- 做，见 ai-ui 的 AiSystemPrompts.wrapUntrustedContext —— 审计列保持纯 JSON 可解析。
-- 原先对象维度的 mq_ai_conversation 表已并入本表。
-- snapshot_id 存的是 ai_connection.connection_id（UUID 字符串，LEFT JOIN 用），
-- 不是自增 id——ai_connection 的主键就是 connection_id。
CREATE TABLE IF NOT EXISTS chat_history (
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    connection_id    TEXT NOT NULL,         -- 连接 UUID
    snapshot_id      TEXT,                  -- 指向 ai_connection.connection_id
    model_name       TEXT NOT NULL,         -- 本次对话用的模型
    token_count      INTEGER DEFAULT 0,     -- 总 token 消耗
    prompt_tokens    INTEGER DEFAULT 0,     -- 输入 token 数
    completion_tokens INTEGER DEFAULT 0,    -- 输出 token 数
    created_time     INTEGER NOT NULL,      -- 用户提问时间（Unix 毫秒）
    started_time     INTEGER,               -- 收到 AI 第一个 token 的时间
    finished_time    INTEGER,               -- AI 回复结束时间
    status           TEXT DEFAULT 'SUCCESS', -- SUCCESS / FAILED / CANCELLED
    error_message    TEXT,                  -- 失败时的错误信息
    finish_reason    TEXT,                  -- stop / length / ...
    question         TEXT,                  -- 用户问题（普通聊天含包装的上下文数据；链路分析存原文）
    reply            TEXT,                  -- AI 回复
    object_type      TEXT,                  -- 链路分析目标类型（QUEUE / CHANNEL / LISTENER）；普通聊天为 NULL
    object_name      TEXT,                  -- 链路分析目标名，如 ORDER.LOCAL.Q；普通聊天为 NULL
    context_json     TEXT                   -- 链路分析的上下文 JSON（currentTime/chain/userQuestion，未包裹不可信边界）；普通聊天为 NULL
);

CREATE INDEX IF NOT EXISTS idx_chat_history_connection_id ON chat_history(connection_id);
CREATE INDEX IF NOT EXISTS idx_chat_history_created_time ON chat_history(created_time DESC);

insertChat:
INSERT INTO chat_history(
    connection_id, snapshot_id, model_name, token_count, prompt_tokens, completion_tokens,
    created_time, started_time, finished_time, status, error_message, finish_reason, question, reply,
    object_type, object_name, context_json
) VALUES (
    ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?
);

selectByConnectionId:
SELECT * FROM chat_history
WHERE connection_id = ?
ORDER BY created_time DESC, id DESC;

selectRecentByConnectionId:
SELECT * FROM chat_history
WHERE connection_id = ?
ORDER BY created_time DESC, id DESC
LIMIT :limit;

selectByModel:
SELECT * FROM chat_history
WHERE connection_id = ? AND model_name = ?
ORDER BY created_time DESC, id DESC;

selectByTimeRange:
SELECT * FROM chat_history
WHERE connection_id = ? AND created_time >= :fromTime AND created_time <= :toTime
ORDER BY created_time DESC, id DESC;

deleteByConnectionId:
DELETE FROM chat_history
WHERE connection_id = ?;

-- DELETE 型语句生成 QueryResult<Long>，executeAsOne() 即受影响行数 ——
-- 删除行数不需要额外的 SELECT changes()。
cleanOld:
DELETE FROM chat_history
WHERE created_time < ?;
