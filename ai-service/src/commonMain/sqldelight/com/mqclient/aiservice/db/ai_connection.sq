-- AI 连接快照表：只在「新建连接」或「service_url 变化」时插入一行。
-- 只插入，不更新，不删除。
-- api_key / name / model / system_prompt / enabled 等只活在 config.toml，不进这张表。
-- prevId 存的是**旧连接的 UUID**（url 变化 = 新 connection_id 接任，prevId 跨连接
-- 追溯旧 lineage；全新建为 NULL），不是本表的自增 id。
-- `AS AiConnection`：物理表名用蛇形，生成的 Kotlin 数据类保持驼峰名。
CREATE TABLE IF NOT EXISTS ai_connection (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    connectionId TEXT NOT NULL,         -- 连接 UUID
    prevId       TEXT,                  -- 旧连接的 UUID（新建 = NULL）
    serviceUrl   TEXT NOT NULL,         -- 服务 URL 快照
    createdTime  INTEGER NOT NULL       -- 快照创建时间（Unix 毫秒）
);

CREATE INDEX IF NOT EXISTS idx_ai_connection_connection_id ON ai_connection(connectionId);
CREATE INDEX IF NOT EXISTS idx_ai_connection_prev_id ON ai_connection(prevId);

insertSnapshot:
INSERT INTO ai_connection(connectionId, prevId, serviceUrl, createdTime)
VALUES (?, ?, ?, ?);

selectLatestByConnectionId:
SELECT * FROM ai_connection
WHERE connectionId = ?
ORDER BY id DESC
LIMIT 1;

selectAllByConnectionId:
SELECT * FROM ai_connection
WHERE connectionId = ?
ORDER BY id ASC;

selectById:
SELECT * FROM ai_connection
WHERE id = ?;
