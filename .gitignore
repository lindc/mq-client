# Maven
target/
*.class

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# IBM MQ 客户端运行时日志（mqjms.log.0 / .1 ...）
mqjms.log.*

# IBM MQ 故障转储（FFDC）
FFDC/

# Gradle
.gradle/
build/
# Machine-specific SDK path (sdk.dir=...) - never commit this
local.properties

# Kotlin / Compose Multiplatform
.kotlin/

# Windows 上 `echo x > nul;` 这类命令的误产物（内容是本机路径），别入库
nul;

# 素材库：字体 / Logo 全量素材，代码零引用（真正打包的是 app-ui 的 composeResources）。
# 必须用 /resources/ 锚定仓库根：不加前导斜杠会连各模块的 src/jvmMain/resources/
# （SPI 的 META-INF/services 就在那里）一起忽略掉。
/resources/

# Agent 工具的本地工作目录（会话产物，与项目无关）。
.codewhale/

# diag 实连测试的本地凭据（chillbear truststore 等，从服务器拷贝，绝不入库）。
.local-test/
